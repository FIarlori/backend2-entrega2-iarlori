    {
      "name": "🎫 6. COMPRA & TICKETS - Lógica Completa de Compra",
      "item": [
        {
          "name": "Purchase Cart - Proceso Completo de Compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/purchase",
              "host": ["{{baseUrl}}"],
              "path": ["carts", "{{cartId}}", "purchase"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('ticketCode', response.ticket.code);",
                  "    console.log('✅ Compra procesada exitosamente');",
                  "    console.log('🎫 Ticket Code:', response.ticket.code);",
                  "    console.log('💰 Total:', response.ticket.amount);",
                  "    console.log('📦 Productos comprados:', response.summary.purchased);",
                  "    console.log('❌ Productos fallidos:', response.summary.failed);",
                  "    ",
                  "    // Verificar que el ticket tiene todos los campos requeridos",
                  "    pm.test(\"Ticket generado correctamente\", function() {",
                  "        pm.expect(response.ticket).to.have.property('code');",
                  "        pm.expect(response.ticket).to.have.property('purchase_datetime');",
                  "        pm.expect(response.ticket).to.have.property('amount');",
                  "        pm.expect(response.ticket).to.have.property('purchaser');",
                  "        pm.expect(response.ticket).to.have.property('products');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
